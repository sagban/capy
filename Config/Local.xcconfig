// Scheme: "capy Local" → Functions emulator (see AppEnvironment.local).
// ./run.sh writes LocalEmulatorHost.xcconfig with your Mac LAN IP (physical device).
// Simulator ignores that and always uses 127.0.0.1 in Swift.
CAPYEmulatorHost = 127.0.0.1
#include? "LocalEmulatorHost.xcconfig"

CAPY_ENVIRONMENT = local
INFOPLIST_KEY_CAPYEnvironment = local
INFOPLIST_KEY_CAPYEmulatorHost = $(CAPYEmulatorHost)
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) CAPY_LOCAL
