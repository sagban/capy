# Local Functions emulator only — copy to functions/.env (gitignored).
# Production: Vertex uses ADC; USDA_FDC_API_KEY comes from Secret Manager
# (override locally with functions/.secret.local).
#
# Do NOT set GOOGLE_CLOUD_PROJECT / GCLOUD_PROJECT here — Firebase reserved keys.

# Vertex Gemini 3 publisher models use location `global` (not us-central1).
GOOGLE_CLOUD_LOCATION=global
VERTEX_GEMINI_MODEL=gemini-3.5-flash
# Named Firestore DB (not (default)) — used by user_store + LangGraph checkpointer.
FIRESTORE_DATABASE_ID=capy
# Prefer system DNS over gRPC c-ares (avoids Firestore 503 DNS timeouts on some corp networks).
GRPC_DNS_RESOLVER=native
GOOGLE_CLOUD_QUOTA_PROJECT=capy-dogfood
# macOS: gunicorn/Functions worker fork + ObjC crash ("initialize may have been in progress").
OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

# Phoenix harness traces (./run.sh starts the UI on :6006 when CAPY_PHOENIX=1)
CAPY_PHOENIX=1
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006
# OTLP path is appended in code (/v1/traces) if missing.
PHOENIX_PROJECT_NAME=capy-harness

# Short-lived access tokens for MCP / HTTP clients (also set via functions/.secret.local as API_ACCESS_TOKEN_SECRET)
# API_ACCESS_TOKEN_SECRET=
