rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // LangGraph checkpoints are written only by Cloud Functions (Admin SDK).
    match /agentGraphCheckpoints/{document=**} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
