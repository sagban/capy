# Cloud config for this checkout. Copy to capy.env (gitignored).
# That is the only file you edit. Then run ./configure.sh.
# ./deploy.sh reads this file, deploys, and writes CAPY_MCP_URL back into it.

# Firebase / GCP project id.
CAPY_GCP_PROJECT=your-gcp-project

# Cloud Run region and service name.
CAPY_REGION=us-central1
CAPY_MCP_SERVICE=capy-mcp

# Filled by ./deploy.sh. The prod iPhone scheme uses it.
CAPY_MCP_URL=https://your-cloud-run-host/mcp/

# Named Firestore database. Use "(default)" only if you created that database.
FIRESTORE_DATABASE_ID=capy

# Vertex. Gemini 3 models use location global.
GOOGLE_CLOUD_LOCATION=global
VERTEX_GEMINI_MODEL=gemini-3.5-flash
VERTEX_GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio

# Local emulator traces. 0 skips the Phoenix UI in ./run.sh.
CAPY_PHOENIX=1

# From GoogleService-Info.plist (API_KEY, CLIENT_ID, REVERSED_CLIENT_ID).
# ./configure.sh copies these from capy/GoogleService-Info.plist when they are still placeholders.
FIREBASE_WEB_API_KEY=
CAPY_GOOGLE_CLIENT_ID=
CAPY_GOOGLE_REVERSED_CLIENT_ID=
