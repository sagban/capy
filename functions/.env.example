# Local Functions emulator only — copy to functions/.env (gitignored).
# Production: Vertex uses ADC; USDA_FDC_API_KEY comes from Secret Manager
# (override locally with functions/.secret.local).
#
# Do NOT set GOOGLE_CLOUD_PROJECT / GCLOUD_PROJECT here — Firebase reserved keys.

GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.5-flash

# Phoenix harness traces (./run.sh starts the UI on :6006 when CAPY_PHOENIX=1)
CAPY_PHOENIX=1
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006
# OTLP path is appended in code (/v1/traces) if missing.
PHOENIX_PROJECT_NAME=capy-harness
