{
  "version": 2,
  "description": "Shared-tool harness evals. A log is search, portion_to_grams, then log_meal.",
  "cases": [
    {
      "id": "cited_menu_item_stages",
      "utterance": "log an iced latte from First Cup",
      "mock_turns": [
        {
          "kind": "tool_calls",
          "text": "Ready to log the iced latte.",
          "calls": [
            {
              "name": "write_food_entry",
              "arguments": {
                "day_key": "2026-10-19",
                "meal_slot": "Snacks",
                "kind": "food",
                "name": "Iced Latte",
                "grams": 355,
                "foodId": "web_latte",
                "source": "web",
                "citationUrl": "https://example.com/first-cup-menu",
                "per100g": {"calories": 42, "proteinG": 2.3, "carbsG": 5.1, "fatG": 1.4}
              }
            }
          ]
        }
      ],
      "expect": {
        "intent": "log_meal",
        "pendingAction": "confirm_log",
        "resolvedSources": ["web"],
        "resolvedNamesAny": ["Iced Latte"]
      }
    },
    {
      "id": "library_exact_title_logs",
      "utterance": "log my Gym Bowl",
      "libraryContext": [
        {
          "id": "lib-gym-bowl",
          "name": "Gym Bowl",
          "kind": "meal",
          "calories": 520,
          "proteinG": 42,
          "carbsG": 48,
          "fatG": 14,
          "servingGrams": 400
        }
      ],
      "mock_turns": [
        {
          "kind": "tool_calls",
          "calls": [{"name": "search_library", "arguments": {"query": "Gym Bowl"}}]
        },
        {
          "kind": "tool_calls",
          "calls": [
            {
              "name": "portion_to_grams",
              "arguments": {
                "quantity": 1,
                "unit": "serving",
                "measures": [{"id": "serving", "label": "1 serving", "grams": 400}]
              }
            }
          ]
        },
        {
          "kind": "tool_calls",
          "calls": [
            {
              "name": "write_food_entry",
              "arguments": {
                "day_key": "2026-10-19",
                "meal_slot": "lunch",
                "kind": "meal",
                "name": "Gym Bowl",
                "grams": 400,
                "foodId": "library_lib-gym-bowl",
                "source": "library",
                "ingredientFamily": "meal",
                "per100g": {"calories": 130, "proteinG": 10.5, "carbsG": 12, "fatG": 3.5}
              }
            }
          ]
        }
      ],
      "expect": {
        "intent": "log_meal",
        "pendingAction": "confirm_log",
        "resolvedSources": ["library"],
        "resolvedNamesAny": ["Gym Bowl"]
      }
    },
    {
      "id": "library_not_overfit_on_staple",
      "utterance": "log chicken",
      "libraryContext": [
        {
          "id": "lib-chicken-feast",
          "name": "Sunday Chicken Feast",
          "kind": "meal",
          "calories": 900,
          "proteinG": 60,
          "carbsG": 70,
          "fatG": 30,
          "servingGrams": 500
        }
      ],
      "mock_turns": [
        {
          "kind": "tool_calls",
          "calls": [{"name": "search_library", "arguments": {"query": "chicken"}}]
        },
        {
          "kind": "tool_calls",
          "calls": [{"name": "search_catalog", "arguments": {"query": "chicken"}}]
        },
        {
          "kind": "tool_calls",
          "calls": [
            {
              "name": "write_food_entry",
              "arguments": {
                "day_key": "2026-10-19",
                "meal_slot": "lunch",
                "kind": "food",
                "name": "Chicken breast, grilled",
                "grams": 100,
                "foodId": "usda_chicken_breast",
                "source": "usda",
                "ingredientFamily": "poultry",
                "per100g": {"calories": 165, "proteinG": 31, "carbsG": 0, "fatG": 3.6}
              }
            }
          ]
        }
      ],
      "expect": {
        "intent": "log_meal",
        "pendingAction": "confirm_log",
        "resolvedSources": ["usda"],
        "resolvedSourcesExclude": ["library"]
      }
    },
    {
      "id": "suggest_then_log",
      "utterance": "suggest lunch",
      "mock_turns": [
        {
          "kind": "tool_calls",
          "calls": [{"name": "search_catalog", "arguments": {"query": "egg"}}]
        },
        {
          "kind": "tool_calls",
          "calls": [
            {
              "name": "portion_to_grams",
              "arguments": {
                "quantity": 2,
                "unit": "large",
                "measures": [{"id": "large", "label": "1 large", "grams": 50}]
              }
            }
          ]
        },
        {"kind": "text", "text": "Eggs fit lunch."}
      ],
      "followUp": {
        "utterance": "log that",
        "mock_turns": [
          {
            "kind": "tool_calls",
            "calls": [
              {
                "name": "write_food_entry",
                "arguments": {
                  "day_key": "2026-10-19",
                  "meal_slot": "Lunch",
                  "kind": "food",
                  "name": "Egg",
                  "grams": 100,
                  "foodId": "seed_egg",
                  "source": "seed",
                  "per100g": {"calories": 155, "proteinG": 13, "carbsG": 1.1, "fatG": 11}
                }
              }
            ]
          }
        ],
        "expect": {"pendingAction": "confirm_log"}
      },
      "expect": {
        "intent": "suggest_meal",
        "minOptions": 1,
        "pendingAction": null
      }
    }
  ]
}
